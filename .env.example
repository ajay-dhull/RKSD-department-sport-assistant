# ─────────────────────────────────────────────────────────────
# RKSD College AI Assistant — environment configuration
# Copy to `.env` and fill in. Never commit the filled-in file.
# ─────────────────────────────────────────────────────────────

# ── Required: Supabase ───────────────────────────────────────
# Project settings → API. The service-role key bypasses RLS —
# server-side only, never expose it to the browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Required: Auth ───────────────────────────────────────────
# Signs teacher / department panel JWTs. Use a long random string.
JWT_SECRET=

# Main admin panel password. CHANGE THIS — it defaults to
# "admin123" if unset, which is fine locally and unsafe anywhere else.
ADMIN_PASSWORD=

# ── Required: AI (at least one Groq key) ─────────────────────
# Free keys: https://console.groq.com
# Add as many as you have — the server rotates through
# GROQ_API_KEY_1 … GROQ_API_KEY_20 when one hits its quota.
GROQ_API_KEY_1=
GROQ_API_KEY_2=
# GROQ_API_KEY_3=
# … up to GROQ_API_KEY_20

# Separate key used by the admin panel's AI data-entry helpers.
GROQ_API_KEY_ADMIN=

# ── Optional: better answers ─────────────────────────────────
# Preferred generation model. Falls back to Groq if unset or failing.
OPENAI_API_KEY=

# Google search fallback, used only when the database has no answer.
# https://serpapi.com — omit to disable the fallback.
SERPAPI_API_KEY=

# ── Optional: premium text-to-speech ─────────────────────────
# Without these the app uses the browser's built-in speech synthesis.
CARTESIA_API_KEY=
ELEVENLABS_API_KEY=

# ── Optional: email subscriptions ────────────────────────────
# Gmail requires an App Password, not your account password:
# https://myaccount.google.com/apppasswords
# Omit all three to disable update emails.
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM_NAME=RKSD College Updates

# ── Server ───────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# Extra CORS origins, comma-separated. Optional.
# ALLOWED_ORIGINS=https://example.com,https://www.example.com

# ── Client (Vite — bundled into the browser build) ───────────
# Only ever put public values here. Leave VITE_API_BASE_URL empty
# to call the API on the same origin.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=
VITE_API_BASE_URL=
